{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --import tsx src/server.ts",
    "dev:worker": "node --watch --watch-preserve-output --import tsx src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@repo/types": "workspace:*",
    "@simplewebauthn/server": "^14.0.3",
    "bullmq": "^5.81.5",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/crypto": "workspace:*",
    "@types/node": "^24.19.2",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
