# Copy to apps/api/.env. Values match docker-compose.yml.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# Primary database (all writes).
DATABASE_URL=postgresql://app:app@localhost:5433/app
# Optional read replica. Unset = reads go to the primary.
# DATABASE_REPLICA_URL=

REDIS_URL=redis://localhost:6380

# Number of reverse proxies in front of the API (load balancer = 1).
# 0 = ignore X-Forwarded-For entirely. Never set higher than the real hop
# count, or clients can spoof their IP.
TRUST_PROXY_HOPS=0

# Where the web app is served. WebAuthn origin + RP ID and email links come
# from it; https:// turns on Secure, __Host- prefixed cookies.
APP_ORIGIN=http://localhost:5173

# Server secrets, 32 random bytes each, base64. Generate one per value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse the dev values in production. Changing SERVER_ENCRYPTION_KEY
# makes existing TOTP secrets unreadable; changing SERVER_HMAC_KEY
# invalidates MFA recovery codes.
SERVER_ENCRYPTION_KEY=
SERVER_HMAC_KEY=

# Outgoing email. Dev: Mailpit from docker-compose (inbox at http://localhost:8025).
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASSWORD=
MAIL_FROM=no-reply@localhost

# Integration tests (append-only audit table, so never the dev DB).
# The app_test database is created by docker/postgres/init.
TEST_DATABASE_URL=postgresql://app:app@localhost:5433/app_test
# Redis for integration tests: a separate DB number, flushed by the tests.
TEST_REDIS_URL=redis://localhost:6380/1
