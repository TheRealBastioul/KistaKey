# Copy to apps/api/.env. Values match docker-compose.yml.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# Primary database (all writes).
DATABASE_URL=postgresql://app:app@localhost:5433/app
# Optional read replica. Unset = reads go to the primary.
# DATABASE_REPLICA_URL=

REDIS_URL=redis://localhost:6380

# Number of reverse proxies in front of the API (load balancer = 1).
# 0 = ignore X-Forwarded-For entirely. Never set higher than the real hop
# count, or clients can spoof their IP.
TRUST_PROXY_HOPS=0

# Integration tests (append-only audit table, so never the dev DB).
# The app_test database is created by docker/postgres/init.
TEST_DATABASE_URL=postgresql://app:app@localhost:5433/app_test
